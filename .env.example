# Server
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/genicheck"

# JWT
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# SMTP (이메일 발송)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="GeniCheck <noreply@genicheck.com>"

# CoolSMS (SMS OTP)
COOLSMS_API_KEY=
COOLSMS_API_SECRET=
COOLSMS_FROM=

# Redis (Access Token 블랙리스트)
REDIS_URL=redis://localhost:6379

# NTS 사업자등록 진위확인 API
NTS_API_KEY=
# true로 바꾸기 전까진 사업자번호를 실제로 검증하지 않음 (팀 테스트 편의용)
NTS_VALIDATION_ENABLED=false

# Frontend URL (평가/HR 초대 링크 이메일 발송용)
# 로컬 개발: http://localhost:5180 / 배포: https://genicheck.vercel.app
FRONTEND_URL=
