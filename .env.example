# Server
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/genicheck"

# JWT
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# SMTP (이메일 발송)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="GeniCheck <noreply@genicheck.com>"

# CoolSMS (SMS OTP)
COOLSMS_API_KEY=
COOLSMS_API_SECRET=
COOLSMS_FROM=

# Redis (Access Token 블랙리스트)
REDIS_URL=redis://localhost:6379

# NTS 사업자등록 진위확인 API
NTS_API_KEY=
# true로 바꾸기 전까진 사업자번호를 실제로 검증하지 않음 (팀 테스트 편의용)
NTS_VALIDATION_ENABLED=false

# Frontend URL (평가/HR 초대 링크 이메일 발송용)
# 로컬 개발: http://localhost:5180 / 배포: https://genicheck.vercel.app
FRONTEND_URL=

# Object Storage (인재 추천 이력서 업로드, S3 호환)
# TODO: AWS S3 / OCI Object Storage 중 어느 쪽을 쓸지 팀 확인 필요
# STORAGE_ENDPOINT를 비우면 AWS S3 기본 엔드포인트를 사용한다
# OCI 예: https://<namespace>.compat.objectstorage.<region>.oraclecloud.com (STORAGE_FORCE_PATH_STYLE=true)
STORAGE_ENDPOINT=
STORAGE_REGION=ap-northeast-2
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_FORCE_PATH_STYLE=false
