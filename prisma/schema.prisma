// GeniCheck Prisma Schema
// 공통 파일 - 스키마 변경 전 반드시 팀원에게 먼저 말한다

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =========================
// Auth / User Models
// =========================

// 지원자 (개인 회원)
model Applicant {
  id               String   @id @default(uuid())
  email            String   @unique
  password         String
  name             String
  refreshToken     String?
  isEmailVerified  Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  consents    Consent[]
  employments Employment[]

  @@map("applicants")
}

// 기업 회원
model Company {
  id             String   @id @default(uuid())
  email          String   @unique
  password       String
  companyName    String
  businessNumber String   @unique
  phone          String
  companyCode    String?  @unique // HR 매니저 로그인 시 사용
  isVerified     Boolean  @default(false)
  isPaid         Boolean  @default(false)
  refreshToken   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  hrManagers  HrManager[]
  consents    Consent[]
  employments Employment[]

  @@map("companies")
}

// HR 담당자 (기업 소속)
model HrManager {
  id           String   @id @default(uuid())
  phone        String   @unique
  name         String
  refreshToken String?
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("hr_managers")
}

// 이메일 인증 (지원자 회원가입 후 이메일 인증)
model EmailVerification {
  id        String   @id @default(uuid())
  email     String
  code      String
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("email_verifications")
}

// OTP 인증 (기업 CEO 로그인 2단계)
model OtpVerification {
  id        String   @id @default(uuid())
  phone     String
  code      String
  expiresAt DateTime
  failCount Int      @default(0)
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("otp_verifications")
}

// =========================
// Consent Model
// =========================

// 동의 (지원자 ↔ 기업)
model Consent {
  id            String    @id @default(uuid())
  applicantId   String
  companyId     String
  step1         Boolean   @default(false)
  step1AgreedAt DateTime?
  step2         Boolean   @default(false)
  step2AgreedAt DateTime?
  agreedTerms   Boolean   @default(false)
  status        String    @default("pending")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  applicant Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("consents")
}

// =========================
// Employment Model
// =========================

// 재직/퇴직 확인 (지원자 ↔ 기업)
model Employment {
  id              String    @id @default(uuid())
  applicantId     String
  companyId       String
  resignationDate DateTime
  reason          String?
  status          String    @default("pending")
  confirmed       Boolean   @default(false)
  confirmedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  applicant Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("employments")
}
