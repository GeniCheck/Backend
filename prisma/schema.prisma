// GeniCheck Prisma Schema
// 공통 파일 - 스키마 변경 전 반드시 팀원에게 먼저 말한다

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =========================
// Auth / User Models
// =========================

// 지원자 (개인 회원)
model Applicant {
  id               String   @id @default(uuid())
  email            String   @unique
  password         String
  name             String
  refreshToken     String?
  isEmailVerified  Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  consents    Consent[]
  employments Employment[]

  @@map("applicants")
}

// 기업 회원
model Company {
  id                 String   @id @default(uuid())
  email              String   @unique
  password           String
  companyName        String
  businessNumber     String   @unique
  representativeName String
  startDate          String   // 개업일자 YYYYMMDD
  phone              String
  companyCode        String?  @unique
  isVerified         Boolean  @default(false)
  isPaid             Boolean  @default(false)
  refreshToken       String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  hrManagers  HrManager[]
  consents    Consent[]
  employments Employment[]

  @@map("companies")
}

// HR 담당자 (기업 소속)
model HrManager {
  id           String   @id @default(uuid())
  phone        String   @unique
  name         String
  refreshToken String?
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("hr_managers")
}

// 이메일 인증
model EmailVerification {
  id        String   @id @default(uuid())
  email     String
  code      String
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("email_verifications")
}

// OTP 인증 (기업 CEO 로그인 2단계)
model OtpVerification {
  id        String   @id @default(uuid())
  phone     String
  code      String
  expiresAt DateTime
  failCount Int      @default(0)
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("otp_verifications")
}

// =========================
// Consent Model
// =========================

model Consent {
  id            String    @id @default(uuid())
  applicantId   String
  companyId     String
  step1         Boolean   @default(false)
  step1AgreedAt DateTime?
  step2         Boolean   @default(false)
  step2AgreedAt DateTime?
  agreedTerms   Boolean   @default(false)
  status        String    @default("pending")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  applicant Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("consents")
}

// =========================
// Employment Model
// =========================

model Employment {
  id                 String    @id @default(uuid())
  applicantId        String
  companyId          String
  resignationDate    DateTime
  reason             String?
  status             String    @default("pending")
  confirmed          Boolean   @default(false)
  confirmedAt        DateTime?
  evaluationOpenAt   DateTime?  // 직원 자기 평가 완료 시각 (골든타임 시작)
  evaluationCloseAt  DateTime?  // evaluationOpenAt + 15일
  windowClosed       Boolean   @default(false)
  rehireIntent       String?    // YES | HOLD | NO (대표만 입력)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  applicant            Applicant             @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  company              Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  evaluationLink       EvaluationLink?
  declarationQuestions DeclarationQuestion[]
  selfEvaluationScores SelfEvaluationScore[]
  ceoEvaluationScores  CeoEvaluationScore[]

  @@map("employments")
}

// =========================
// Evaluation Models
// =========================

// 1회성 평가 링크
model EvaluationLink {
  id           String   @id @default(uuid())
  employmentId String   @unique
  token        String   @unique
  status       String   @default("pending") // pending | used | expired
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  employment Employment @relation(fields: [employmentId], references: [id], onDelete: Cascade)

  @@map("evaluation_links")
}

// 대표가 입사 시 만든 질문
model DeclarationQuestion {
  id           String   @id @default(uuid())
  employmentId String
  content      String
  order        Int      @default(0)
  createdAt    DateTime @default(now())

  employment Employment        @relation(fields: [employmentId], references: [id], onDelete: Cascade)
  answer     DeclarationAnswer?

  @@map("declaration_questions")
}

// 직원이 입력한 답변 (자기 선언)
model DeclarationAnswer {
  id         String   @id @default(uuid())
  questionId String   @unique
  content    String
  createdAt  DateTime @default(now())

  question          DeclarationQuestion  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selfEvaluationScore SelfEvaluationScore?
  ceoEvaluationScore  CeoEvaluationScore?

  @@map("declaration_answers")
}

// 직원 자기 평가 점수 (선언별, 서술형 필드 없음)
model SelfEvaluationScore {
  id           String   @id @default(uuid())
  answerId     String   @unique
  employmentId String
  score        Int      // 1~10
  submittedAt  DateTime @default(now())
  createdAt    DateTime @default(now())

  answer     DeclarationAnswer @relation(fields: [answerId], references: [id], onDelete: Cascade)
  employment Employment        @relation(fields: [employmentId], references: [id], onDelete: Cascade)

  @@map("self_evaluation_scores")
}

// 대표 검증 점수 (선언별, 서술형 필드 없음)
model CeoEvaluationScore {
  id           String    @id @default(uuid())
  answerId     String    @unique
  employmentId String
  score        Int?      // 1~10
  submittedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  answer     DeclarationAnswer @relation(fields: [answerId], references: [id], onDelete: Cascade)
  employment Employment        @relation(fields: [employmentId], references: [id], onDelete: Cascade)

  @@map("ceo_evaluation_scores")
}
